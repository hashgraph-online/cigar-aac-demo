# Optional public witnessing. The complete demo works with these fields empty.
# Copy this template to .env locally. Never commit the populated .env file.
# Follow docs/HEDERA-SETUP.md to create a Hedera Portal testnet account.
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# Optional: reuse the topic shown after a successful Hedera run.
# If empty, the demo creates one topic per server session when first needed.
HEDERA_TOPIC_ID=
HEDERA_TIMEOUT_MS=20000

# Local witness is always the default in the UI, even with credentials present.
# npm start -- --offline bypasses .env entirely.
# DEMO_OFFLINE=1

# Optional local server settings (loopback only by default).
# PORT=4319
# HOST=127.0.0.1

# Optional absolute path to an existing Python 3.14 virtual environment.
# Configure this in your shell before npm start/setup so setup uses it too.
# CIGAR_PYTHON=/absolute/path/to/venv/bin/python
